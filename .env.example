# ─── Ethen Building — frontend local development ─────────────────────────────
# Backend runs on 4090 (NOT the 4000 default in api-client.js — that would hit
# the original project's backend if it is running).
NEXT_PUBLIC_API_URL=http://localhost:4090/api/v1

# Single switch for the whole mapping stack (renderer AND geocoding/search):
#   nominatim -> Leaflet + OpenStreetMap  (free, no key, current)
#   google    -> Google Maps JS + Places API New  (needs the key below)
NEXT_PUBLIC_MAP_PROVIDER=nominatim

# PENDING: paste the Google Maps key here, then flip MAP_PROVIDER to `google`.
# Required APIs in Google Cloud: Maps JavaScript API + Places API (New).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
